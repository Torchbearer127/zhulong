{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhulong.local/schemas/recording-evidence.schema.json",
  "title": "Zhulong final recording evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recording_status",
    "canonical_identity",
    "video",
    "replay",
    "obs",
    "stages",
    "screenshots",
    "registrations",
    "archive",
    "transaction"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "recording_status": { "enum": ["staging", "passed", "failed"] },
    "canonical_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "software_name",
        "tested_ref",
        "tested_ref_kind",
        "finding_slug",
        "direct_impact_marker",
        "oracle_marker",
        "code_context_identity",
        "trigger_context_identity"
      ],
      "properties": {
        "software_name": { "type": "string", "minLength": 1 },
        "tested_ref": { "type": "string", "minLength": 1 },
        "tested_ref_kind": { "enum": ["version", "branch", "commit", "tag", "ref", "source_ref"] },
        "finding_slug": { "type": "string", "minLength": 1 },
        "direct_impact_marker": { "type": "string", "minLength": 1 },
        "oracle_marker": { "type": "string", "minLength": 1 },
        "code_context_identity": { "type": "string", "minLength": 1 },
        "trigger_context_identity": { "type": "string", "minLength": 1 }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size", "duration_seconds", "width", "height"],
      "properties": {
        "path": { "type": "string", "pattern": "^[^/].*" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["script_path", "script_sha256", "exit_code"],
      "properties": {
        "script_path": { "type": "string", "pattern": "^[^/].*" },
        "script_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "exit_code": { "type": "integer" }
      }
    },
    "obs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_name", "source_kind", "window_identity", "window_title", "window_stable"],
      "properties": {
        "source_name": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["window_capture", "display_capture", "fixture_media"] },
        "window_identity": { "type": "string", "minLength": 1 },
        "window_title": { "type": "string", "minLength": 1 },
        "window_stable": { "const": true }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "sequence",
          "event_timestamp",
          "video_timestamp",
          "hold_start",
          "hold_end",
          "expected_marker",
          "canonical_identity",
          "source_name",
          "source_window_identity",
          "source_checkpoint",
          "frame"
        ],
        "properties": {
          "stage": { "enum": ["identity", "code_or_trigger_context", "final_impact"] },
          "sequence": { "type": "integer", "minimum": 1, "maximum": 3 },
          "event_timestamp": { "type": "number", "minimum": 0 },
          "video_timestamp": { "type": "number", "minimum": 0 },
          "hold_start": { "type": "number", "minimum": 0 },
          "hold_end": { "type": "number", "exclusiveMinimum": 0 },
          "expected_marker": { "type": "string", "minLength": 1 },
          "source_name": { "type": "string", "minLength": 1 },
          "source_window_identity": { "type": "string", "minLength": 1 },
          "canonical_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["software_name", "tested_ref", "finding_slug", "code_context_identity", "trigger_context_identity"],
            "properties": {
              "software_name": { "type": "string", "minLength": 1 },
              "tested_ref": { "type": "string", "minLength": 1 },
              "finding_slug": { "type": "string", "minLength": 1 },
              "code_context_identity": { "type": "string", "minLength": 1 },
              "trigger_context_identity": { "type": "string", "minLength": 1 }
            }
          },
          "source_checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256", "width", "height"],
            "properties": {
              "name": { "type": "string", "pattern": "^[^/].*" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 }
            }
          },
          "frame": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "width", "height", "perceptual_similarity", "recording_time_observations"],
            "properties": {
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "perceptual_similarity": { "type": "number", "minimum": 0, "maximum": 1 },
              "recording_time_observations": {
                "type": "array",
                "minItems": 1,
                "description": "Recorder-supplied recording-time consistency claims. They are non-authoritative and never independent visual content proof.",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "screenshots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "path", "sha256", "size", "width", "height", "video_timestamp", "source_frame_sha256"],
        "properties": {
          "stage": { "enum": ["identity", "code_or_trigger_context", "final_impact"] },
          "path": { "type": "string", "pattern": "^[^/].*" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "video_timestamp": { "type": "number", "minimum": 0 },
          "source_frame_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "registrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_evidence_path", "reviewer_index_path", "attachment_inventory_path", "screenshot_paths"],
      "properties": {
        "verification_evidence_path": { "const": "verification-evidence.json" },
        "reviewer_index_path": { "const": "attachments/reviewer-evidence-index.json" },
        "attachment_inventory_path": { "type": "string", "minLength": 1 },
        "screenshot_paths": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "string", "pattern": "^[^/].*" }
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "archive_name", "testzip", "required_entries", "recording_ready", "submission_ready"],
      "properties": {
        "status": { "enum": ["not_ready", "ready", "failed"] },
        "archive_name": { "type": "string", "minLength": 1 },
        "archive_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "archive_size": { "type": "integer", "minimum": 1 },
        "testzip": { "const": null },
        "required_entries": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "recording_ready": { "type": "boolean" },
        "submission_ready": { "type": "boolean" }
      }
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "owner_marker", "promotion_status", "rollback_safe", "full_recording_time_validated"],
      "properties": {
        "owner": { "const": "zhulong-recording" },
        "owner_marker": { "type": "string", "minLength": 1 },
        "promotion_status": { "enum": ["staging", "promoted", "failed", "rolled_back"] },
        "rollback_safe": { "const": true },
        "full_recording_time_validated": { "type": "boolean" }
      }
    }
  }
}
