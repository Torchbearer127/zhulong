{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zhulong Root Skill Rule Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "inventory_id": {"const": "zhulong-root-skill-rules"},
    "rules": {
      "type": "array",
      "minItems": 14,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "safe_path": {
      "type": "string",
      "pattern": "^(skills/zhulong/SKILL\\.md|assets/references/[A-Za-z0-9][A-Za-z0-9._-]*|assets/schemas/[A-Za-z0-9][A-Za-z0-9._-]*|scripts/[A-Za-z0-9][A-Za-z0-9._-]*|docs/runner-contracts/[A-Za-z0-9][A-Za-z0-9._-]*)$"
    },
    "carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "enum": [
            "production_schema",
            "production_validator",
            "production_gate",
            "fixed_wrapper",
            "root_kernel",
            "reference",
            "selftest"
          ]
        },
        "path": {"$ref": "#/$defs/safe_path"},
        "symbol": {"type": "string", "minLength": 2, "maxLength": 200}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "section"],
      "properties": {
        "path": {"$ref": "#/$defs/safe_path"},
        "section": {"type": "string", "minLength": 2, "maxLength": 160}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "source_scope",
        "rule_class",
        "disposition",
        "target",
        "carriers",
        "rationale",
        "residual_boundary"
      ],
      "properties": {
        "rule_id": {"type": "string", "pattern": "^ZR-[A-Z0-9][A-Z0-9-]{2,39}$"},
        "source_scope": {"type": "string", "minLength": 3, "maxLength": 240},
        "rule_class": {"enum": ["hard_constraint", "phase_protocol", "operational_guidance"]},
        "disposition": {"enum": ["retain_kernel", "move_to_reference"]},
        "target": {"$ref": "#/$defs/target"},
        "carriers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/carrier"}
        },
        "rationale": {"type": "string", "minLength": 8, "maxLength": 500},
        "residual_boundary": {"type": "string", "minLength": 8, "maxLength": 500}
      }
    }
  }
}
