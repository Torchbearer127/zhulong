{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Torchbearer127/zhulong/blob/main/assets/schemas/candidate-dedup-plan.schema.json",
  "title": "Zhulong Candidate Deduplication Advisory Plan R1",
  "description": "Advisory candidate-only plan with no verifier, disposition, bundle, or finalization authority.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "inventory", "candidates", "classifications", "exact_groups", "authority"],
  "properties": {
    "schema_version": {"const": 1}, "plan_id": {"type": "string", "pattern": "^DEDUP-[0-9a-f]{16}$"},
    "inventory": {"$ref": "#/$defs/binding"},
    "candidates": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/candidate"}},
    "classifications": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/classification"}},
    "exact_groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "authority": {"const": "candidate_advisory_only"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "pattern": "^CAND-[0-9A-Za-z._-]+$"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_kind", "source_id", "artifact_path", "artifact_sha256"], "properties": {"source_kind": {"enum": ["agent", "scanner", "manual_review", "seeded_variant", "imported_legacy"]}, "source_id": {"type": "string"}, "artifact_path": {"$ref": "#/$defs/path"}, "artifact_sha256": {"$ref": "#/$defs/sha256"}, "observed_at": {"type": "string", "format": "date-time"}, "producer": {"$ref": "#/$defs/producer"}}},
    "binding": {"type": "object", "additionalProperties": false, "required": ["inventory_id", "path", "sha256"], "properties": {"inventory_id": {"type": "string"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "path", "sha256", "protocol_mode", "fingerprint", "target_tested_ref"], "properties": {"candidate_id": {"$ref": "#/$defs/candidate_id"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha256"}, "protocol_mode": {"enum": ["legacy_r1", "r2"]}, "fingerprint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "target_tested_ref": {"type": "string"}}},
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["left_candidate_id", "right_candidate_id", "classification", "reason_code", "canonical_candidate_id"],
      "properties": {
        "left_candidate_id": {"$ref": "#/$defs/candidate_id"},
        "right_candidate_id": {"$ref": "#/$defs/candidate_id"},
        "classification": {"enum": ["exact_duplicate", "review_required", "distinct"]},
        "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
        "canonical_candidate_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/candidate_id"}]}
      }
    },
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["fingerprint", "canonical_candidate_id", "member_candidate_ids", "merged_provenance"],
      "properties": {
        "fingerprint": {"$ref": "#/$defs/sha256"},
        "canonical_candidate_id": {"$ref": "#/$defs/candidate_id"},
        "member_candidate_ids": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/candidate_id"}},
        "merged_provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}
      }
    }
  }
}
