{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Torchbearer127/zhulong/blob/main/assets/schemas/candidate-identity-input.schema.json",
  "title": "Zhulong Candidate R1 to R2 Explicit Identity Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_commit", "trust_boundary_id", "sink_family", "root_cause_family", "primary_source_path", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "target_commit": {"type": "string", "minLength": 1},
    "trust_boundary_id": {"type": ["string", "null"]},
    "sink_family": {"type": "string", "minLength": 1},
    "root_cause_family": {"type": "string", "minLength": 1},
    "primary_source_path": {"type": "string", "minLength": 1},
    "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provenance"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "producer": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_kind", "source_id", "artifact_path", "artifact_sha256"],
      "properties": {
        "source_kind": {"enum": ["agent", "scanner", "manual_review", "seeded_variant", "imported_legacy"]},
        "source_id": {"type": "string", "minLength": 1}, "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}, "observed_at": {"type": "string", "format": "date-time"},
        "producer": {"$ref": "#/$defs/producer"}
      }
    }
  }
}
