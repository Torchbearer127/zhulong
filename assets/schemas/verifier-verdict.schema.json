{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Torchbearer127/zhulong/blob/main/assets/schemas/verifier-verdict.schema.json",
  "title": "Zhulong Verifier Verdict Contract R1",
  "description": "Independent verification verdict contract. Only this contract may recommend confirmed_in_docker before disposition promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "verdict",
    "verification_status",
    "evidence_level",
    "target_ref",
    "environment",
    "commands",
    "oracle_result",
    "disposition_recommendation",
    "negative_checks",
    "artifacts",
    "verified_at"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^CAND-[0-9A-Za-z._-]+$"
    },
    "verdict": {
      "$ref": "#/definitions/verdict"
    },
    "verification_status": {
      "$ref": "#/definitions/verdict"
    },
    "evidence_level": {
      "$ref": "#/definitions/evidence_level"
    },
    "target_ref": {
      "$ref": "#/definitions/target_ref"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fresh_container",
        "runtime_type",
        "host_network",
        "privileged",
        "docker_socket_mounted",
        "credential_paths_mounted",
        "egress_policy"
      ],
      "properties": {
        "fresh_container": {
          "type": "boolean"
        },
        "runtime_type": {
          "type": "string",
          "enum": [
            "docker",
            "docker-compose",
            "manual-blocked"
          ]
        },
        "host_network": {
          "type": "boolean"
        },
        "privileged": {
          "type": "boolean"
        },
        "docker_socket_mounted": {
          "type": "boolean"
        },
        "credential_paths_mounted": {
          "type": "boolean"
        },
        "egress_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "exit_code"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer"
          }
        }
      }
    },
    "oracle_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "success",
        "summary"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "success": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "attacker_entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "route",
        "input_shape",
        "entrypoint_to_sink_path",
        "deterministic_impact_oracle"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "input_shape": {
          "type": "string",
          "minLength": 1
        },
        "entrypoint_to_sink_path": {
          "type": "string",
          "minLength": 1
        },
        "deterministic_impact_oracle": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "replay_material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "$ref": "#/definitions/repo_relative_path"
        },
        "generation_command": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "generation_command"
          ]
        }
      ]
    },
    "disposition_recommendation": {
      "$ref": "#/definitions/verdict"
    },
    "negative_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "passed"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/repo_relative_path"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "confirmed_in_docker"
          }
        }
      },
      "then": {
        "properties": {
          "environment": {
            "properties": {
              "fresh_container": {
                "const": true
              },
              "host_network": {
                "const": false
              },
              "privileged": {
                "const": false
              },
              "docker_socket_mounted": {
                "const": false
              },
              "credential_paths_mounted": {
                "const": false
              }
            }
          },
          "commands": {
            "minItems": 1
          },
          "oracle_result": {
            "properties": {
              "success": {
                "const": true
              }
            }
          },
          "artifacts": {
            "minItems": 1
          },
          "evidence_level": {
            "enum": [
              "entrypoint_reproduced",
              "confirmed_in_docker"
            ]
          }
        },
        "required": [
          "attacker_entrypoint",
          "replay_material"
        ]
      }
    }
  ],
  "definitions": {
    "evidence_level": {
      "type": "string",
      "enum": [
        "code_level_reproduced",
        "entrypoint_reproduced",
        "confirmed_in_docker",
        "blocked_entrypoint_verification"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "blocked",
        "false_positive",
        "unverified",
        "confirmed_in_docker"
      ]
    },
    "target_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_config",
        "tested_ref"
      ],
      "properties": {
        "target_config": {
          "$ref": "#/definitions/repo_relative_path"
        },
        "tested_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repo_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!file://)(?!~)(?!.*(^|/)\\.\\.($|/)).+"
    }
  }
}
